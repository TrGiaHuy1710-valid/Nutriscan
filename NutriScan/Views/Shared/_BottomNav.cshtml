@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<div class="bottom-nav">

    <a asp-controller="Home"
       asp-action="Index"
       class="nav-item @(currentAction == "Index" ? "active" : "")">

        <i class="fa-solid fa-house"></i>
        Home

    </a>

    <a asp-controller="Home"
       asp-action="Nutrition"
       class="nav-item @(currentAction == "Nutrition" ? "active" : "")">

        <i class="fa-solid fa-utensils"></i>
        Food

    </a>

    <!-- QR BUTTON -->

    <a asp-controller="Home"
       asp-action="QRScan"
       class="qr-button @(currentAction == "QRScan" ? "active-qr" : "")">

        <i class="fa-solid fa-qrcode"></i>

    </a>

    <a asp-controller="Home"
       asp-action="AI"
       class="nav-item @(currentAction == "AI" ? "active" : "")">

        <i class="fa-solid fa-brain"></i>
        AI

    </a>

    <a asp-controller="Home"
       asp-action="Workout"
       class="nav-item @(currentAction == "Workout" ? "active" : "")">

        <i class="fa-solid fa-dumbbell"></i>
        Workout

    </a>

</div>