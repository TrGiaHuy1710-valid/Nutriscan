@{
    ViewData["Title"] = "Yêu thích";
}

<div class="app-container">
    <!-- Header -->
    <header class="page-header">
        <a asp-controller="Home" asp-action="Index" class="page-header__back">
            <i class="fa-solid fa-angle-left"></i>
        </a>
        <h1 class="page-header__title">Thực phẩm yêu thích</h1>
    </header>

    <div class="page-content" style="display: flex; flex-direction: column; gap: var(--space-3);">
        <div id="favoritesListContainer" style="display: flex; flex-direction: column; gap: var(--space-3);">
            <!-- Favorite cards loaded dynamically -->
        </div>

        <div class="empty-state" id="emptyState" style="display: none;">
            <div class="empty-state__icon">
                <i class="fa-solid fa-heart-crack"></i>
            </div>
            <p class="empty-state__title">Chưa có mục yêu thích</p>
            <p class="empty-state__text" style="margin-bottom: var(--space-5);">Lưu các sản phẩm bạn thường ăn để truy cập nhanh chóng.</p>
            <a asp-controller="Home" asp-action="Nutrition" class="btn btn--primary">Quét sản phẩm</a>
        </div>
    </div>

    <partial name="_BottomNav" />
</div>

<script>
    async function loadFavorites() {
        const favContainer = document.getElementById('favoritesListContainer');
        const emptyState = document.getElementById('emptyState');

        try {
            const response = await fetch('/api/scans/favorites');
            if (!response.ok) throw new Error('API error');
            const data = await response.json();

            if (!data || data.length === 0) {
                favContainer.innerHTML = '';
                emptyState.style.display = 'block';
                return;
            }

            emptyState.style.display = 'none';
            favContainer.innerHTML = '';

            data.forEach(item => {
                const dateObj = new Date(item.scannedDate);
                const formattedDate = dateObj.toLocaleDateString('vi-VN', { 
                    day: '2-digit', 
                    month: '2-digit', 
                    year: 'numeric' 
                });

                const card = document.createElement('div');
                card.className = 'card';
                card.style.padding = 'var(--space-4)';

                card.innerHTML = `
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
                        <div>
                            <span class="text-xs text-muted font-medium">Đã lưu ngày ${formattedDate}</span>
                            <h3 class="text-sm font-bold" style="margin-top: 2px; word-break: break-all;">${item.productName || 'Thực phẩm quét'}</h3>
                        </div>
                        <button onclick="removeFavorite(${item.id})" class="btn--ghost" style="padding: 4px; color: var(--color-danger);">
                            <i class="fa-solid fa-heart"></i>
                        </button>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: var(--space-2); background: var(--color-bg); padding: var(--space-2); border-radius: var(--radius-sm); margin-top: 8px;">
                        <div style="text-align: center;">
                            <div class="text-xs text-muted">Calo</div>
                            <div class="text-xs font-bold" style="color: var(--color-calories);">${item.calories}</div>
                        </div>
                        <div style="text-align: center;">
                            <div class="text-xs text-muted">Đạm</div>
                            <div class="text-xs font-bold" style="color: var(--color-protein);">${item.protein}g</div>
                        </div>
                        <div style="text-align: center;">
                            <div class="text-xs text-muted">Carb</div>
                            <div class="text-xs font-bold" style="color: var(--color-carbs);">${item.carbs}g</div>
                        </div>
                        <div style="text-align: center;">
                            <div class="text-xs text-muted">Béo</div>
                            <div class="text-xs font-bold" style="color: var(--color-fat);">${item.fat}g</div>
                        </div>
                    </div>

                    ${item.notes ? `
                    <div style="margin-top: 8px; padding-top: 8px; border-top: 1px solid var(--color-border-light); font-size: 11px; color: var(--color-text-secondary);">
                        <i class="fa-solid fa-note-sticky" style="margin-right: 4px;"></i> ${item.notes}
                    </div>
                    ` : ''}
                `;

                favContainer.appendChild(card);
            });
        } catch (err) {
            console.error('Error loading favorites:', err);
            emptyState.style.display = 'block';
        }
    }

    async function removeFavorite(id) {
        if (!confirm('Bạn muốn bỏ lưu thực phẩm này khỏi mục yêu thích?')) return;
        try {
            const r = await fetch(`/api/scans/${id}/favorite`, { method: 'POST' });
            if (r.ok) {
                loadFavorites();
            }
        } catch (e) {
            console.error(e);
        }
    }

    window.addEventListener('load', loadFavorites);
</script>
