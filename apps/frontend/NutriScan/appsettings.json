{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Services": {
    "Ocr": {
      "BaseUrl": "http://localhost:5000",
      "AnalyzePath": "/api/analyze-food",
      "TimeoutSeconds": 45
    },
    "FoodValidate": {
      "BaseUrl": "http://localhost:8000",
      "ValidatePath": "/api/v1/food/validate",
      "TimeoutSeconds": 5,
      "Enabled": true
    }
  },
  "AllowedHosts": "*"
}
